{
  "name": "live-writer",
  "displayName": "Live Writer",
  "description": "Live Writer: write Markdown, LaTeX and Quarto in their rendered form. Obsidian-style wikilinks, callouts and footnotes; citations from your .bib, one click from the PDF in Zotero; TikZ pictures from your last build; Claude sees the selection and paraphrases it. Mermaid and draw.io drawn inline (formerly md-live-preview-plus).",
  "version": "1.4.0",
  "publisher": "kasemsit",
  "license": "MIT",
  "icon": "media/icon-128.png",
  "keywords": [
    "markdown",
    "markdown editor",
    "markdown preview",
    "live preview",
    "wysiwyg",
    "obsidian",
    "note taking",
    "notes",
    "mermaid",
    "preview",
    "css theme",
    "editor",
    "drawio",
    "draw.io",
    "diagrams.net",
    "diagram",
    "architecture diagram",
    "markdown live preview",
    "markdown wysiwyg",
    "wysiwyg editor",
    "typora",
    "zettelkasten",
    "knowledge base",
    "documentation",
    "readme",
    "writing",
    "katex",
    "latex",
    "overleaf",
    "tex"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kasemsit/live-writer.git"
  },
  "bugs": {
    "url": "https://github.com/kasemsit/live-writer/issues"
  },
  "homepage": "https://github.com/kasemsit/live-writer#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "liveWriter.editor",
        "displayName": "Live Writer (Markdown, LaTeX, Quarto)",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          },
          {
            "filenamePattern": "*.tex"
          },
          {
            "filenamePattern": "*.qmd"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "liveWriter",
          "title": "Markdown Live Preview Editor",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "liveWriter": [
        {
          "id": "liveWriter.outline",
          "name": "%view.outline%",
          "type": "webview"
        },
        {
          "id": "liveWriter.plus.backlinks",
          "name": "Backlinks"
        },
        {
          "id": "liveWriter.styleManager",
          "name": "%view.styleManager%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "liveWriter.openWithLivePreview",
        "title": "%command.openWithLivePreview%",
        "category": "Markdown Live Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "liveWriter.openWithSource",
        "title": "%command.openWithSource%",
        "category": "Markdown Live Preview",
        "icon": "$(go-to-file)"
      },
      {
        "command": "liveWriter.newStyle",
        "title": "%command.newStyle%",
        "category": "Markdown Live Preview",
        "icon": "$(add)"
      },
      {
        "command": "liveWriter.plus.insertFootnote",
        "title": "Insert Footnote",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.clearClaudeSelection",
        "title": "Stop Sending the Selection to Claude",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.refreshBacklinks",
        "title": "Refresh Backlinks",
        "category": "Markdown Live Preview",
        "icon": "$(refresh)"
      },
      {
        "command": "liveWriter.plus.openAt",
        "title": "Open Backlink",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.askClaude",
        "title": "Ask Claude About the Selection",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.copyRichText",
        "title": "Copy as Rich Text",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.copyBlockLink",
        "title": "Copy Link to This Block",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.copyTex",
        "title": "Copy TeX",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.table.copyTsv",
        "title": "Copy Table as Tab-Separated Text",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.openLinkBeside",
        "title": "Open Link to the Side",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.openInZotero",
        "title": "Open PDF in Zotero",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.paraphrase",
        "title": "Paraphrase",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.openAsTextHere",
        "title": "Open as Text at This Line",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.openInObsidian",
        "title": "Open in Obsidian",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.addReviewComment",
        "title": "Add REVIEW Comment",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.renumberFootnotes",
        "title": "Renumber Footnotes in Order",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.table.insertRowAbove",
        "title": "Insert Row Above",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.table.insertRowBelow",
        "title": "Insert Row Below",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.table.insertColumnLeft",
        "title": "Insert Column Left",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.table.insertColumnRight",
        "title": "Insert Column Right",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.table.deleteRow",
        "title": "Delete Row",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.table.deleteColumn",
        "title": "Delete Column",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.table.sortAscending",
        "title": "Sort Table by This Column (A→Z)",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.table.sortDescending",
        "title": "Sort Table by This Column (Z→A)",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.searchGoogle",
        "title": "Search Google",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.searchScholar",
        "title": "Search Google Scholar",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.textLarger",
        "title": "Larger Text",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.textSmaller",
        "title": "Smaller Text",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.textReset",
        "title": "Reset Text Size",
        "category": "Markdown Live Preview"
      },
      {
        "command": "liveWriter.plus.insertCitation",
        "title": "Insert Citation from Zotero",
        "category": "Live Writer"
      },
      {
        "command": "liveWriter.plus.rewriteTighten",
        "title": "Tighten",
        "category": "Live Writer"
      },
      {
        "command": "liveWriter.plus.rewriteFormal",
        "title": "More Formal",
        "category": "Live Writer"
      },
      {
        "command": "liveWriter.plus.rewriteToEnglish",
        "title": "Translate to English",
        "category": "Live Writer"
      },
      {
        "command": "liveWriter.plus.rewriteToThai",
        "title": "Translate to Thai",
        "category": "Live Writer"
      },
      {
        "command": "liveWriter.plus.showInPdf",
        "title": "Show in PDF",
        "category": "Live Writer"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "liveWriter.openWithLivePreview",
          "when": "(resourceLangId == markdown || resourceLangId == latex || resourceExtname == .qmd) && activeCustomEditorId != liveWriter.editor",
          "group": "navigation"
        },
        {
          "command": "liveWriter.openWithSource",
          "when": "activeCustomEditorId == liveWriter.editor",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "liveWriter.newStyle",
          "when": "view == liveWriter.styleManager",
          "group": "navigation"
        },
        {
          "command": "liveWriter.plus.refreshBacklinks",
          "when": "view == liveWriter.plus.backlinks",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "liveWriter.plus.openAt",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.askClaude",
          "when": "activeCustomEditorId == liveWriter.editor"
        },
        {
          "command": "liveWriter.plus.copyRichText",
          "when": "activeCustomEditorId == liveWriter.editor"
        },
        {
          "command": "liveWriter.plus.copyBlockLink",
          "when": "activeCustomEditorId == liveWriter.editor"
        },
        {
          "command": "liveWriter.plus.copyTex",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.table.copyTsv",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.openLinkBeside",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.openInZotero",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.paraphrase",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.openAsTextHere",
          "when": "activeCustomEditorId == liveWriter.editor"
        },
        {
          "command": "liveWriter.plus.openInObsidian",
          "when": "activeCustomEditorId == liveWriter.editor"
        },
        {
          "command": "liveWriter.plus.addReviewComment",
          "when": "activeCustomEditorId == liveWriter.editor"
        },
        {
          "command": "liveWriter.plus.renumberFootnotes",
          "when": "activeCustomEditorId == liveWriter.editor"
        },
        {
          "command": "liveWriter.plus.table.insertRowAbove",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.table.insertRowBelow",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.table.insertColumnLeft",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.table.insertColumnRight",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.table.deleteRow",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.table.deleteColumn",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.table.sortAscending",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.table.sortDescending",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.searchGoogle",
          "when": "activeCustomEditorId == liveWriter.editor"
        },
        {
          "command": "liveWriter.plus.searchScholar",
          "when": "activeCustomEditorId == liveWriter.editor"
        },
        {
          "command": "liveWriter.plus.insertCitation",
          "when": "activeCustomEditorId == liveWriter.editor"
        },
        {
          "command": "liveWriter.plus.rewriteTighten",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.rewriteFormal",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.rewriteToEnglish",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.rewriteToThai",
          "when": "false"
        },
        {
          "command": "liveWriter.plus.showInPdf",
          "when": "activeCustomEditorId == liveWriter.editor"
        }
      ],
      "webview/context": [
        {
          "command": "liveWriter.plus.askClaude",
          "when": "webviewId == 'liveWriter.editor' && mlpHasSelection",
          "group": "1_plus_claude@1"
        },
        {
          "submenu": "liveWriter.rewrite",
          "when": "webviewId == 'liveWriter.editor' && mlpHasSelection",
          "group": "1_plus_claude@2"
        },
        {
          "command": "liveWriter.plus.copyRichText",
          "when": "webviewId == 'liveWriter.editor' && !mlpTex",
          "group": "2_plus_copy@1"
        },
        {
          "command": "liveWriter.plus.copyBlockLink",
          "when": "webviewId == 'liveWriter.editor' && !mlpTex",
          "group": "2_plus_copy@2"
        },
        {
          "command": "liveWriter.plus.copyTex",
          "when": "webviewId == 'liveWriter.editor' && mlpMath",
          "group": "2_plus_copy@3"
        },
        {
          "command": "liveWriter.plus.table.copyTsv",
          "when": "webviewId == 'liveWriter.editor' && mlpTable",
          "group": "2_plus_copy@4"
        },
        {
          "command": "liveWriter.plus.openLinkBeside",
          "when": "webviewId == 'liveWriter.editor' && mlpLink",
          "group": "3_plus_open@1"
        },
        {
          "command": "liveWriter.plus.openInZotero",
          "when": "webviewId == 'liveWriter.editor' && mlpCite",
          "group": "3_plus_open@2"
        },
        {
          "command": "liveWriter.plus.openAsTextHere",
          "when": "webviewId == 'liveWriter.editor'",
          "group": "3_plus_open@2"
        },
        {
          "command": "liveWriter.plus.openInObsidian",
          "when": "webviewId == 'liveWriter.editor' && !mlpTex",
          "group": "3_plus_open@3"
        },
        {
          "command": "liveWriter.plus.addReviewComment",
          "when": "webviewId == 'liveWriter.editor'",
          "group": "4_plus_edit@1"
        },
        {
          "command": "liveWriter.plus.renumberFootnotes",
          "when": "webviewId == 'liveWriter.editor' && mlpHasFootnotes",
          "group": "4_plus_edit@2"
        },
        {
          "command": "liveWriter.plus.table.insertRowAbove",
          "when": "webviewId == 'liveWriter.editor' && mlpTable",
          "group": "5_plus_table@1"
        },
        {
          "command": "liveWriter.plus.table.insertRowBelow",
          "when": "webviewId == 'liveWriter.editor' && mlpTable",
          "group": "5_plus_table@2"
        },
        {
          "command": "liveWriter.plus.table.insertColumnLeft",
          "when": "webviewId == 'liveWriter.editor' && mlpTable",
          "group": "5_plus_table@3"
        },
        {
          "command": "liveWriter.plus.table.insertColumnRight",
          "when": "webviewId == 'liveWriter.editor' && mlpTable",
          "group": "5_plus_table@4"
        },
        {
          "command": "liveWriter.plus.table.deleteRow",
          "when": "webviewId == 'liveWriter.editor' && mlpTable",
          "group": "5_plus_table@5"
        },
        {
          "command": "liveWriter.plus.table.deleteColumn",
          "when": "webviewId == 'liveWriter.editor' && mlpTable",
          "group": "5_plus_table@6"
        },
        {
          "command": "liveWriter.plus.table.sortAscending",
          "when": "webviewId == 'liveWriter.editor' && mlpTable",
          "group": "5_plus_table@7"
        },
        {
          "command": "liveWriter.plus.table.sortDescending",
          "when": "webviewId == 'liveWriter.editor' && mlpTable",
          "group": "5_plus_table@8"
        },
        {
          "command": "liveWriter.plus.searchGoogle",
          "when": "webviewId == 'liveWriter.editor' && mlpHasSelection",
          "group": "1_plus_search@1"
        },
        {
          "command": "liveWriter.plus.searchScholar",
          "when": "webviewId == 'liveWriter.editor' && mlpHasSelection",
          "group": "1_plus_search@2"
        },
        {
          "command": "liveWriter.plus.textLarger",
          "when": "webviewId == 'liveWriter.editor'",
          "group": "7_plus_view@1"
        },
        {
          "command": "liveWriter.plus.textSmaller",
          "when": "webviewId == 'liveWriter.editor'",
          "group": "7_plus_view@2"
        },
        {
          "command": "liveWriter.plus.textReset",
          "when": "webviewId == 'liveWriter.editor'",
          "group": "7_plus_view@3"
        },
        {
          "command": "liveWriter.plus.insertCitation",
          "when": "webviewId == 'liveWriter.editor'",
          "group": "3_plus_open@3"
        },
        {
          "command": "liveWriter.plus.showInPdf",
          "when": "webviewId == 'liveWriter.editor' && mlpTex",
          "group": "3_plus_open@0"
        }
      ],
      "liveWriter.rewrite": [
        {
          "command": "liveWriter.plus.paraphrase",
          "group": "1_style@0"
        },
        {
          "command": "liveWriter.plus.rewriteTighten",
          "group": "1_style@1"
        },
        {
          "command": "liveWriter.plus.rewriteFormal",
          "group": "1_style@2"
        },
        {
          "command": "liveWriter.plus.rewriteToEnglish",
          "group": "2_translate@3"
        },
        {
          "command": "liveWriter.plus.rewriteToThai",
          "group": "2_translate@4"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Live Preview",
      "properties": {
        "liveWriter.codeTheme": {
          "type": "string",
          "enum": [
            "auto",
            "dark-plus",
            "light-plus",
            "github-dark",
            "github-light"
          ],
          "enumDescriptions": [
            "%config.codeTheme.auto%",
            "%config.codeTheme.darkPlus%",
            "%config.codeTheme.lightPlus%",
            "%config.codeTheme.githubDark%",
            "%config.codeTheme.githubLight%"
          ],
          "default": "auto",
          "description": "%config.codeTheme%"
        },
        "liveWriter.enabledStyles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "description": "%config.enabledStyles%"
        },
        "liveWriter.defaultEditor": {
          "type": "string",
          "enum": [
            "prompt",
            "livePreview",
            "default"
          ],
          "enumDescriptions": [
            "%config.defaultEditor.prompt%",
            "%config.defaultEditor.livePreview%",
            "%config.defaultEditor.default%"
          ],
          "default": "prompt",
          "description": "%config.defaultEditor%"
        },
        "liveWriter.plus.shareSelectionWithClaude": {
          "type": "boolean",
          "default": true,
          "description": "Live Writer: write the text selected in the Live Preview to ~/.claude/live-preview-selection.json (only if ~/.claude exists), where the bundled Claude Code hook passes it to Claude."
        },
        "liveWriter.plus.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Live Writer: once a day, check GitHub Releases (api.github.com) for a newer version and offer the download page."
        },
        "liveWriter.plus.textScale": {
          "type": "number",
          "default": 1,
          "minimum": 0.7,
          "maximum": 2,
          "description": "Live Writer: text size in the Live Preview, as a factor over the CSS theme's own size (1 = as the theme sets it). Changed by Larger Text / Smaller Text in the right-click menu."
        },
        "liveWriter.plus.fontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "Live Writer: the font of the text in the Live Preview, as CSS `font-family`, e.g. `Sarabun, 'TH Sarabun New', sans-serif`. Empty keeps the CSS theme's font. Code and formulas keep theirs."
        },
        "liveWriter.plus.trackExternalChanges": {
          "type": "boolean",
          "default": true,
          "description": "Live Writer: when an open note changes on disk (Claude or another program writing it, a git checkout), show the changes in the Live Preview — insertions green, deletions struck through — to keep or undo one by one."
        },
        "liveWriter.plus.claudeModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Live Writer: the Claude model for *Rewrite with Claude* (a name or an alias such as `sonnet` or `opus`). Empty uses Claude Code's default."
        }
      }
    },
    "keybindings": [
      {
        "command": "liveWriter.plus.insertFootnote",
        "key": "ctrl+alt+6",
        "mac": "cmd+alt+6",
        "when": "activeCustomEditorId == liveWriter.editor"
      },
      {
        "command": "liveWriter.plus.insertCitation",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "activeCustomEditorId == liveWriter.editor"
      },
      {
        "command": "liveWriter.plus.showInPdf",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "activeCustomEditorId == liveWriter.editor"
      }
    ],
    "submenus": [
      {
        "id": "liveWriter.rewrite",
        "label": "Rewrite with Claude"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js && tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:related": "vitest related --run",
    "test:coverage": "vitest run --coverage.enabled",
    "test:integration": "tsc -p tsconfig.test.json && vscode-test",
    "test:e2e": "playwright test",
    "test:all": "npm run test:coverage && npm run test:integration && npm run test:e2e",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit -p tsconfig.json --watch",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "fast-check": "^4.9.0",
    "mocha": "^12.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.6",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.3.2",
    "@shikijs/core": "^1.24.0",
    "@shikijs/engine-javascript": "^1.24.0",
    "@shikijs/langs": "^1.24.0",
    "@shikijs/themes": "^1.24.0",
    "katex": "^0.16.47",
    "mermaid": "^11.4.1",
    "yaml": "^2.9.0"
  }
}
